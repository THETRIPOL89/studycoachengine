# ============================================================
# STUDY COACH - Environment Variables
# ============================================================
# Questo file è il TEMPLATE committato. I valori sono segnaposto.
# Copia in .env.local e sostituisci con le tue chiavi vere.
# MAI committare .env.local (vedi .gitignore).
#
# Configurazione dual-provider attiva:
#   - NVIDIA NIM  -> generateSubtopicsForTopic (subtopics per il piano)
#   - Groq        -> analyzeMaterialWithAI, generateQuizFromMaterial,
#                   explainConcept (analisi materiali, quiz, AI Tutor)
# Per cambiare la divisione dei compiti, vedi sezione "Switch provider"
# in README.md. Entrambi i provider sono free tier, no carta richiesta.
# ============================================================

# --- NVIDIA NIM (subtopics, attivo) ---
# Ottieni la key su: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
# Modello per generare le subtopics. Sostituiscilo se "has reached its end".
NIM_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Groq (analisi materiali, quiz, AI Tutor, attivo) ---
# Ottieni la key su: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
# Modello Groq per analisi materiali (default) e quiz/spiegazioni (fast).
# Sostituiscilo se lo slug viene decommissato.
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-120b

# ============================================================
# Provider alternativi (NON attivi, commentati per reference)
# ============================================================

# (Provider alternativo, non attivo: Google AI Studio / Gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_DEFAULT_MODEL=gemini-3.7-flash
# GEMINI_FAST_MODEL=gemini-3.7-flash

# (Provider alternativo, non attivo: OpenRouter)
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# OPENROUTER_DEFAULT_MODEL=qwen/qwen-2.5-72b-instruct:free
# OPENROUTER_FAST_MODEL=qwen/qwen-2.5-7b-instruct:free

# ============================================================
# SUPABASE (obbligatorio)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# STRIPE (pagamenti Premium tier)
# ============================================================
# Modalità: test mode in dev (sk_test_*, pk_test_*, whsec_* da Stripe CLI),
# live mode in prod (sk_live_*, pk_live_*, whsec_* dal Dashboard Stripe).
# I 3 Price ID sotto (price_xxx) vanno creati nel Dashboard Stripe
# (Products -> il tuo prodotto "Study Coach Premium" -> 3 prezzi ricorrenti).

# Chiave segreta server-side (MAI esporre al client).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Pubblicabile (NON usata in questo MVP, Stripe Checkout è hosted).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Ottenuto con `stripe listen --forward-to ...` (dev) o dal Dashboard (prod).
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Price ID dei 3 piani ricorrenti (sostituisci con i tuoi da Stripe Dashboard).
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_SEMESTRAL=price_your_semestral_price_id
STRIPE_PRICE_ANNUAL=price_your_annual_price_id

# URL pubblico dell'app (usato per success_url/cancel_url di Stripe Checkout).
# DEV: http://localhost:3000
# PROD: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
